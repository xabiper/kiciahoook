local ROW_H = 48

-- grey-to-white gradient outline for the pills around tab text (hidden until hovered)
local function pillOutline(parent)
	local st = new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 1, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, parent)
	new("UIGradient", { Color = ColorSequence.new(Color3.fromHex("#6b6b78"), Color3.new(1, 1, 1)), Rotation = 90 }, st)
	return st
end

-- label with two offset ghost copies, used to fake a blur on entry
local function blurLabel(parent, text, size, color, font, props, ghosts)
	local px, py = props.Position.X.Offset, props.Position.Y.Offset
	for _, dx in ipairs({ -1.5, 1.5 }) do
		local g = label(parent, text, size, color, font, { Position = UDim2.fromOffset(px + dx, py), Size = props.Size, TextXAlignment = props.TextXAlignment, ZIndex = 3 })
		g.TextTransparency = 0.5
		table.insert(ghosts, g)
	end
	return label(parent, text, size, color, font, props)
end

local function buildPage(tab)
	local holder = new("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, GroupTransparency = 1, ZIndex = 2 }, pageArea)
	local scroll = new("ScrollingFrame", {
		Position = UDim2.fromOffset(14, 2),
		Size = UDim2.new(1, -28, 1, -18),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.scroll,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 2,
	}, holder)
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	new("UIPadding", { PaddingBottom = UDim.new(0, 16) }, scroll)
	local rowIx = 0
	local groupsHere = {}
	for gi, g in ipairs(tab.groups) do
		if g.closed == nil then
			g.closed = false
		end
		local group = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = gi, ZIndex = 2 }, scroll)
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, group)
		new("UIPadding", { PaddingBottom = UDim.new(0, 12) }, group)
		local head = new("TextButton", { Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = 1, ZIndex = 3 }, group)
		local hlabel = label(head, g.title, 11.5, ACCENT2, F_BLACK, { Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -30, 1, 0), ZIndex = 3 })
		local chev
		if ASSETS.chrome.chevUp ~= "" then
			chev = new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, Image = ASSETS.chrome.chevUp, ImageColor3 = C.mut, ZIndex = 3 }, head)
		else
			chev = label(head, "∧", 12, C.mut, F_BOLD, { Position = UDim2.new(1, -16, 0, 0), Size = UDim2.fromOffset(12, 28), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3 })
		end
		if g.closed then
			chev.Rotation = 180
		end
		local hlSc = new("UIScale", {}, hlabel)
		-- hover pill behind the title text: the squish needs a visible shape to show on
		local hpill = new("Frame", { Position = UDim2.fromOffset(2, 2), Size = UDim2.fromOffset(textW(g.title, 11.5, F_BLACK) + 12, 24), BackgroundColor3 = Color3.fromHex("#2a2a33"), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2 }, head)
		corner(hpill, 999)
		local hOutline = pillOutline(hpill)
		head.MouseEnter:Connect(function()
			tween(hOutline, { Transparency = 0.1 }, 0.2)
			tween(hlabel, { TextColor3 = ACCENT, Position = UDim2.fromOffset(6, 0) }, 0.2) -- hover: darker pink
			tween(hpill, { BackgroundTransparency = 0.3 }, 0.2)
		end)
		head.MouseLeave:Connect(function()
			tween(hOutline, { Transparency = 1 }, 0.2)
			tween(hlabel, { TextColor3 = ACCENT2, Position = UDim2.fromOffset(4, 0) }, 0.2)
			tween(hpill, { BackgroundTransparency = 1 }, 0.2)
		end)
		squishy(head, 1.02, 0.94, 0.94, 1.05, hpill) -- hover/press squish on the title pill
		local bodyF = new("Frame", { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, ClipsDescendants = false, LayoutOrder = 2, ZIndex = 2 }, group) -- rows pop out past the card
		local card = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.panel, BorderSizePixel = 0, ZIndex = 2 }, bodyF)
		corner(card, 13)
		stroke(card, C.white, 0.94, 1)
		new("UIPadding", { PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5), PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5) }, card)
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, card)

		local hs = spring(g.closed and 0 or 1, 280, 26) -- 0 closed, 1 open
		local function bodyH()
			return card.AbsoluteSize.Y
		end
		tick(function()
			if group.Parent == nil then
				return false
			end
			local h = bodyH()
			bodyF.Size = UDim2.new(1, 0, 0, math.floor(h * math.clamp(hs.x, 0, 1) + 0.5))
			return true
		end)
		head.Activated:Connect(function()
			g.closed = not g.closed
			setT(hs, g.closed and 0 or 1)
			tween(chev, { Rotation = g.closed and 180 or 0 }, 0.5, Enum.EasingStyle.Back)
		end)

		for ii, item in ipairs(g.items) do
			rowIx = rowIx + 1
			local row = new("CanvasGroup", { Size = UDim2.new(1, 0, 0, ROW_H), BackgroundColor3 = C.row, BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = ii, GroupTransparency = 1, ZIndex = 3 }, card)
			corner(row, 10)
			toCenter(row)
			local hv = spring(1, 420, 18)
			local rh = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 1 }, row)
			squishy(rh, 1.004, 0.996, 0.99, 1.01, row) -- .row:hover / .row:active
			local ro = (item.title .. " " .. item.desc):lower()
			local entry = { row = row, group = group, q = ro }
			table.insert(rowsIndex, entry)
			-- Roblox has no per-element blur, so the text gets two offset ghost copies that fade out on entry
			local ghosts = {}
			blurLabel(row, item.title, 12.5, C.txt, F_SEMI, { Position = UDim2.fromOffset(11, 9), Size = UDim2.new(1, -220, 0, 16), ZIndex = 4 }, ghosts)
			blurLabel(row, item.desc, 11, C.mut, F_REG, { Position = UDim2.fromOffset(11, 26), Size = UDim2.new(1, -220, 0, 14), ZIndex = 4 }, ghosts)
			row.MouseEnter:Connect(function()
				tween(row, { BackgroundTransparency = 0 }, 0.18)
			end)
			row.MouseLeave:Connect(function()
				tween(row, { BackgroundTransparency = 1 }, 0.18)
			end)
			local ctrl = CONTROLS[item.kind]
			if ctrl then
				ctrl(row, item)
			end
			-- rows bounce in with the stagger from the web build
			local delay = math.min(70 + (rowIx - 1) * 30, 520) / 1000
			-- index.html rowIn (.55s): 0% (.92,.96) -> 55% (1.02,.985) -> 75% (.995,1.008) -> 100% (1,1)
			-- each row fades in while it grows far past its box, then shrinks back to normal size
			-- its own tick drives the row's Size directly, so the squish system can't cancel it
			local E_KF = { { 0, 0.55, 0.55 }, { 0.16, 1.3, 1.3 }, { 0.3, 0.9, 0.9 }, { 0.4, 1.04, 1.04 }, { 0.48, 1, 1 } }
			local e0 = T + delay
			local eSample = kfPlay(E_KF, e0)
			FX[row].entering = true
			tick(function()
				if row.Parent == nil then
					return false
				end
				if T < e0 then
					return true
				end
				if T - e0 >= E_KF[#E_KF][1] then
					FX[row].entering = false
					row.Size = UDim2.new(1, 0, 0, ROW_H)
					return false
				end
				local kx, ky = eSample()
				row.Size = UDim2.new(kx, 0, 0, ROW_H * ky)
				return true
			end)
			task.delay(delay, function()
				if row.Parent == nil then
					return
				end
				tween(row, { GroupTransparency = 0 }, 0.35)
				-- the blur clears: ghost copies fade out while the row fades in
				for _, g in ipairs(ghosts) do
					tween(g, { TextTransparency = 1 }, 0.6)
				end
			end)
		end
		table.insert(groupsHere, group)
		groupsIndex[#groupsIndex + 1] = group
	end
	local emptyText = ASSETS.chrome.star ~= "" and "nothing matches — try another word" or "nothing matches — try another word ✦"
	local empty = label(holder, emptyText, 12, C.dim, F_REG, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = false,
		ZIndex = 3,
	})
	emptyMsg = empty
	if ASSETS.chrome.star ~= "" then
		local tw = textW(emptyText, 12, F_REG)
		new("ImageLabel", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0.5, math.floor(tw / 2) + 6, 0.5, 0),
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			Image = ASSETS.chrome.star,
			ImageColor3 = C.dim,
			ZIndex = 3,
		}, empty)
	end
	-- page fade + rise, like pageIn
	holder.Position = UDim2.fromOffset(0, 12)
	tween(holder, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, 0.45, Enum.EasingStyle.Quint)
	return holder
end

local function applyFilter()
	local q = searchIn.Text:gsub("^%s+", ""):gsub("%s+$", ""):lower()
	local visible = 0
	for _, e in ipairs(rowsIndex) do
		if e.row.Parent then
			local hit = (q == "") or (string.find(e.q, q, 1, true) ~= nil)
			e.row.Visible = hit
			if hit then
				visible = visible + 1
			end
		end
	end
	for _, grp in ipairs(groupsIndex) do
		if grp.Parent then
			local n = 0
			for _, child in ipairs(grp:GetDescendants()) do
				if child:IsA("CanvasGroup") and child.Visible then
					n = n + 1
				end
			end
			grp.Visible = (q == "") or (n > 0)
		end
	end
	if emptyMsg then
		local showE = (q ~= "") and visible == 0
		if showE and not emptyMsg.Visible then
			emptyMsg.TextTransparency = 1
			tween(emptyMsg, { TextTransparency = 0 }, 0.45)
		end
		emptyMsg.Visible = showE
	end
end
searchIn:GetPropertyChangedSignal("Text"):Connect(applyFilter)

local pageToken = 0
local function showPage(sec, tab)
	pageToken = pageToken + 1
	local myToken = pageToken
	local old = pageHolder
	pageHolder = nil
	closePopup()
	listening = nil
	local function build()
		rowsIndex = {}
		groupsIndex = {}
		pageHolder = buildPage(tab)
		applyFilter()
	end
	if old then
		-- the old page fades out first; the new one is only built after it is gone, so the two never show together
		tween(old, { GroupTransparency = 1 }, 0.1)
		task.delay(0.12, function()
			old:Destroy()
			if myToken == pageToken then
				build()
			end
		end)
	else
		build()
	end
end

-- tabs ------------------------------------------------------------------
pillTo = function(pos, inst)
	if inst then
		snap(tabPill.a, pos[1])
		snap(tabPill.b, pos[2])
	else
		setT(tabPill.a, pos[1])
		setT(tabPill.b, pos[2])
		kickPill(tabPill)
	end
end

local function buildTabs(sec, instant)
	for _, b in ipairs(tabBtns) do
		b:Destroy()
	end
	tabBtns = {}
	if tabPill then
		tabPill.frame:Destroy()
	end
	tabPill = makePill(tabsEl, true)
	-- the selected tab keeps the grey-to-white outline on its pill
	tabPillOutline = pillOutline(tabPill.frame)
	tabPillOutline.Transparency = 0.2
	local x = 0
	local positions = {}
	for ti, tab in ipairs(sec.tabs) do
		local w = textW(tab.id, 12, F_SEMI) + 28
		local b = new("TextButton", {
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.fromOffset(w, 28),
			BackgroundColor3 = Color3.fromHex("#2a2a33"), -- hover pill: the squish needs a visible shape to show on
			BackgroundTransparency = 1,
			Text = tab.id,
			Font = F_SEMI,
			TextSize = 12,
			TextColor3 = C.mut,
			AutoButtonColor = false,
			ZIndex = 3,
		}, tabsEl)
		positions[ti] = { x, x + w }
		tabBtns[ti] = b
		corner(b, 999)
		b.MouseEnter:Connect(function()
			if currentTab ~= tab then
				tween(b, { TextColor3 = ACCENT, BackgroundTransparency = 0.3 }, 0.15) -- hover: darker pink text, pill appears
			end
		end)
		b.MouseLeave:Connect(function()
			if currentTab ~= tab then
				tween(b, { TextColor3 = C.mut, BackgroundTransparency = 1 }, 0.15)
			end
		end)
		b.Activated:Connect(function()
			if currentTab == tab then
				return
			end
			local prevIdx = table.find(sec.tabs, currentTab)
			currentTab = tab
			-- the hover pill must not stay behind on the tab we just left, or on the one we picked
			if prevIdx and prevIdx ~= ti and tabBtns[prevIdx] then
				tween(tabBtns[prevIdx], { BackgroundTransparency = 1 }, 0.15)
			end
			tween(b, { BackgroundTransparency = 1 }, 0.15)
			pillTo(positions[ti])
			for j, bb in ipairs(tabBtns) do
				tween(bb, { TextColor3 = (j == ti) and ACCENT2 or C.mut }, 0.2)
			end
			showPage(sec, tab)
		end)
		local tsq = squishy(b, 1.04, 0.9, 0.86, 0.8) -- hover: stretched sideways and squashed down; press: bundled up
		snap(tsq, 0.85)
		task.delay((ti - 1) * 0.045, function()
			if b.Parent then
				setT(tsq, 1)
			end
		end)
		x = x + w + 4
	end
	pillTo(positions[1], instant)
	for j, bb in ipairs(tabBtns) do
		bb.TextColor3 = (j == 1) and ACCENT2 or C.mut
	end
end

selectSection = function(sec, instant)
	local si = table.find(DATA, sec)
	currentSec = sec
	currentTab = sec.tabs[1]
	setNavOn(si)
	if instant then
		snap(navPill.a, (si - 1) * NAV_STEP)
		snap(navPill.b, (si - 1) * NAV_STEP + 36)
	else
		setT(navPill.a, (si - 1) * NAV_STEP)
		setT(navPill.b, (si - 1) * NAV_STEP + 36)
		kickPill(navPill)
	end
	buildTabs(sec, instant)
	showPage(sec, currentTab)
end

