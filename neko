-- flags + menu data (mirrors DATA in index.html)
-- =====================================================================
local Flags = {}
local onFlag = {}

-- configs: name -> snapshot of Flags. Names are unique (case-insensitive).
local HttpService = game:GetService("HttpService")
local CONFIG_FILE = "neko_configs.json"
local settings = {} -- autoload = config name, cl_autoload_on, cl_silent
local configs = {}
local activeConfig = nil
if readfile then
	pcall(function()
		local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
		if type(data) == "table" then
			configs = type(data.configs) == "table" and data.configs or {}
			settings = type(data.settings) == "table" and data.settings or {}
		end
	end)
end
-- auto load: apply the chosen config before the menu is built, so every control starts from it
if settings.cl_autoload_on == true and settings.autoload and configs[settings.autoload] then
	for k, v in pairs(configs[settings.autoload]) do
		Flags[k] = v
	end
end
Flags.cl_autoload_on = settings.cl_autoload_on == true
Flags.cl_silent = settings.cl_silent == true
local function copyFlags()
	local t = {}
	for k, v in pairs(Flags) do
		t[k] = v
	end
	return t
end
local function saveConfigs()
	if writefile then
		pcall(function()
			writefile(CONFIG_FILE, HttpService:JSONEncode({ configs = configs, settings = settings }))
		end)
	end
end
local function nameTaken(name)
	for k in pairs(configs) do
		if string.lower(k) == string.lower(name) then
			return true
		end
	end
	return false
end

local loadingConfig = false
local function setFlag(id, value)
	Flags[id] = value
	if onFlag[id] then
		onFlag[id](value)
	end
	-- the active config saves every change made after it was created
	if activeConfig and not loadingConfig then
		configs[activeConfig] = copyFlags()
		saveConfigs()
	end
	-- the two Loading toggles are remembered on their own, so they survive restarts
	if id == "cl_autoload_on" or id == "cl_silent" then
		settings[id] = value
		saveConfigs()
	end
end

-- write the current settings into the active config; false if no config has been created yet
local function saveActive()
	if not activeConfig then
		return false
	end
	configs[activeConfig] = copyFlags()
	saveConfigs()
	return true
end

-- load a saved config: every control updates to its saved value, then it becomes the active config
local function applyConfig(name)
	local c = configs[name]
	if not c then
		return false
	end
	loadingConfig = true
	for k, v in pairs(c) do
		if k ~= "cl_autoload_on" and k ~= "cl_silent" then
			setFlag(k, v)
		end
	end
	loadingConfig = false
	activeConfig = name
	saveConfigs()
	return true
end

