UIS.InputBegan:Connect(function(input, gp)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if listening then
			local f = listening
			listening = nil
			f(input)
			return
		end
		if UIS:GetFocusedTextBox() then
			return
		end
		local k = input.KeyCode.Name
		if k == Flags.cl_key then
			if hidden then
				showWin()
			else
				hideWin("min")
			end
			return
		end
		if Flags.m_panic ~= "Unbound" and k == Flags.m_panic then
			hideWin("closing")
			return
		end
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 and popup then
		local m = guiMouse()
		if not inside(popup.frame, m) and not inside(popup.btn, m) then
			closePopup()
		end
	end
end)

