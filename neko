local function setAccent(name)
	local pair = ACCENTS[name] or ACCENTS.Pink
	ACCENT = Color3.fromHex(pair[1])
	ACCENT2 = Color3.fromHex(pair[2])
	for i = #themes, 1, -1 do
		if themes[i]() == false then
			table.remove(themes, i)
		end
	end
	-- nav / tab / page text that is currently accent2 follows the new accent
	for j, nb in ipairs(navBtns) do
		if currentSec == DATA[j] then
			nb.TextColor3 = ACCENT2
		end
	end
	for j, bb in ipairs(tabBtns) do
		if currentTab == currentSec.tabs[j] then
			bb.TextColor3 = ACCENT2
		end
	end
	if logo and wmFps then
		wmFps.TextColor3 = ACCENT2
	end
end

