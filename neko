-- semi squish that pulses in time with the float: wider as it goes up, taller as it comes down
FX[dockBtn].kf = function()
	local w = math.sin(2 * math.pi * T / 0.9)
	return 1 + 0.035 * w, 1 - 0.035 * w
end

hideWin = function(mode)
