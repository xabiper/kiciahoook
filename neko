-- nav (taffy pill: leading and trailing edges on different springs)
-- pill selection kick: very aggressive squash/stretch, out then in (like the toggle knob)
local PILL_KF = { { 0, 1, 1 }, { 0.12, 1.35, 0.6 }, { 0.26, 0.8, 1.3 }, { 0.4, 1.1, 0.9 }, { 0.55, 1, 1 } }
local function kickPill(P)
	P.kf = kfPlay(PILL_KF, T)
end

local function makePill(parent, horizontal)
	local f = new("Frame", { BackgroundColor3 = C.rowH, BorderSizePixel = 0, ZIndex = 1 }, parent)
	corner(f, 10)
	stroke(f, C.white, 0.94, 1)
	-- index.html: tabX = Spring(0) (420, 22), tabW = Spring(0, 420, 26)
	local a = spring(0, 420, 22)
	local b = spring(0, 420, 26)
	killWith(a, f)
	killWith(b, f)
	local P = { frame = f, a = a, b = b }
	tick(function()
		if f.Parent == nil then
			return false
		end
		-- taffy: stretch with velocity, anchored on the side the pill is moving away from
		local st = math.clamp(a.v * 0.0012, -0.4, 0.4)
		local w = math.max(b.x - a.x, 6)
		local sw = w * (1 + math.abs(st))
		local start = a.x
		if a.v < 0 then
			start = b.x - sw
		end
		local ex, ey = 1, 1
		if P.kf then
			ex, ey = P.kf()
		end
		if horizontal then
			-- sorta opacity: a little see-through while it slides, solid when it lands
			f.BackgroundTransparency = math.clamp(0.1 + math.abs(a.v) * 0.0006, 0.1, 0.5)
		end
		if horizontal then
			local H = 28
			local nw = sw * ex
			local px0 = start + sw / 2 - nw / 2
			local pw = f.Parent.AbsoluteSize.X
			if pw > 0 then
				px0 = math.clamp(px0, 0, math.max(0, pw - nw)) -- never past the tab bar edges
			end
			f.Position = UDim2.fromOffset(px0, (H - H * ey) / 2)
			f.Size = UDim2.fromOffset(nw, H * ey)
		else
			local nh = sw * ey
			f.Position = UDim2.new(0.5 * (1 - ex), 0, 0, start + sw / 2 - nh / 2)
			f.Size = UDim2.new(ex, 0, 0, nh)
		end
		return true
	end)
	return P
end

