-- true while the pointer is over the menu, the dock button, or an open dropdown
local function overUI()
	local m = guiMouse()
	if win.Visible and inside(win, m) then
		return true
	end
	if dock.Visible and inside(dock, m) then
		return true
	end
	if popup and inside(popup.frame, m) then
		return true
	end
	return false
end

-- menu open: unlock the mouse and swallow clicks that land on the menu, so the game never sees them
local mouseBefore = nil
sinkOn = function()
	if not mouseBefore then
		mouseBefore = UIS.MouseBehavior
	end
	UIS.MouseBehavior = Enum.MouseBehavior.Default
	UIS.MouseIconEnabled = true
	CAS:BindActionAtPriority(SINK_NAME, function()
		if overUI() then
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.ContextActionPriority.High.Value,
		Enum.UserInputType.MouseButton1, Enum.UserInputType.MouseButton2, Enum.UserInputType.MouseButton3, Enum.UserInputType.Touch)
end
sinkOff = function()
	CAS:UnbindAction(SINK_NAME)
	if mouseBefore then
		UIS.MouseBehavior = mouseBefore
		mouseBefore = nil
	end
end

end

showWin = function()
