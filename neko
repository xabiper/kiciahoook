-- Unload: first click shows "Are you sure (3)" and counts down; a second click during the countdown unloads
local function ctrlUnload(row, item)
	local w = math.max(120, textW("Are you sure (3)", 11.5, F_BOLD) + 32)
	local b = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(w, 28),
		BackgroundColor3 = Color3.fromHex("#f472b6"),
		BorderSizePixel = 0,
		Text = item.label,
		Font = F_BOLD,
		TextSize = 11.5,
		TextColor3 = C.white,
		AutoButtonColor = false,
		ZIndex = 2,
	}, row)
	corner(b, 9)
	local grad = new("UIGradient", { Color = ColorSequence.new(Color3.fromHex("#f472b6"), Color3.fromHex("#ec4899")), Rotation = 45 }, b)
	themed(b, function()
		grad.Color = ColorSequence.new(Color3.fromHex("#f472b6"), Color3.fromHex("#ec4899"))
	end)
	squishy(b, 1.05, 0.94, 0.9, 0.9)
	local armed = false
	b.Activated:Connect(function()
		popStretch(b)
		if armed then
			if _G.NEKO_STOP then
				_G.NEKO_STOP()
			end
			return
		end
		armed = true
		b.Text = "Are you sure (3)"
		task.spawn(function()
			local count = 3
			while count > 0 and armed do
				task.wait(1)
				if not armed then
					break
				end
				count = count - 1
				if b.Parent == nil then
					return
				end
				b.Text = "Are you sure (" .. count .. ")"
			end
			if armed and b.Parent then
				task.wait(0.4) -- show "(0)" briefly before resetting
				if armed and b.Parent then
					armed = false
					b.Text = item.label
				end
			end
		end)
	end)
end

