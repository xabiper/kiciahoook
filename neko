	local queue = queue_on_teleport or (syn and syn.queue_on_teleport)
	if queue and settings.cl_autoload_on == true and settings.autoload then
		queue('loadstring(game:HttpGet("' .. NEKO_SOURCE_URL .. '"))()')
	end
end
