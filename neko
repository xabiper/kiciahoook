-- window motion springs (K110 / D13 like the web build)
local px = spring(0, 110, 13)
local py = spring(0, 110, 13)
local sc = spring(1, 200, 12) -- a little bounce at the end of open/close
local offY = spring(0, 230, 10) -- restore slide / minimize drop (bouncier, like --springier)
-- index.html winIn (.65s): per-axis squash/stretch on open, 0% (.8,.86) -> 60% (1.03,.98) -> 80% (.99,1.01) -> 100%
local openKF = nil
-- content follows the black box only while opening and closing (not while it is dragged/bounced)
local followUntil = 0
local closingNow = false
-- up/down bounce for open and close: low damping so it wobbles several times before settling
local bounceY = spring(0, 260, 7)
local rotX = spring(0, 300, 20) -- close tilt (winClose: rotate -2deg)
local maxed = false
local hidden = true
local dragging = false
local gx, gy = 0, 0
local uiScaleSetting = 1

local function winW()
	return win.AbsoluteSize.X
end
local function clampTarget()
	local vp = screen.AbsoluteSize
	setT(px, math.clamp(px.t, -winW() + 90, vp.X - 90))
	setT(py, math.clamp(py.t, 0, vp.Y - 46))
end
local function centerWindow()
	local vp = screen.AbsoluteSize
	setT(px, (vp.X - WIN_W) / 2)
	setT(py, math.max(14, (vp.Y - WIN_H) / 2 - 10))
	clampTarget()
end

tick(function()
	local vp = screen.AbsoluteSize
	local breath = 1 + math.sin(T * 1000 / 850) * 0.005
	-- drag tilt: leans into the motion, more than before (up to 6 degrees), and reacts to vertical speed too
	local rot = math.clamp(px.v * 0.022 + py.v * 0.004, -6, 6)
	-- px/py are still the top-left corner; the anchor is the center, so add half the size
	win.Position = UDim2.fromOffset(px.x + win.Size.X.Offset / 2, py.x + offY.x + bounceY.x + win.Size.Y.Offset / 2)
	win.Rotation = rot + rotX.x
	winScale.Scale = math.max(sc.x, 0) * breath * uiScaleSetting
	-- jelly: stretch along the motion and squash across it, on the body only
	-- (the window box itself stays put, so maximize and resize keep working)
	local jx = math.clamp(math.abs(px.v) * 0.00012, 0, 0.05)
	local jy = math.clamp(math.abs(py.v) * 0.0001, 0, 0.04)
	shape.AnchorPoint = Vector2.new(0.5, 0.5)
	shape.Position = UDim2.fromScale(0.5, 0.5)
	local ox, oy = 1, 1
	if openKF then
		ox, oy = openKF()
	end
	shape.Size = UDim2.new((1 + jx - jy * 0.5) * ox, 0, (1 + jy - jx * 0.5) * oy, 0)
	-- content: matches the box while opening / closing, otherwise stays put
	inner.AnchorPoint = Vector2.new(0.5, 0.5)
	inner.Position = UDim2.fromScale(0.5, 0.5)
	if T < followUntil or closingNow then
		inner.Size = shape.Size
	else
		inner.Size = UDim2.fromScale(1, 1)
	end
	-- the white titlebar follows the black shape: same width, same top edge
	tbar.AnchorPoint = Vector2.new(0.5, 0)
	tbar.Position = UDim2.new(0.5, 0, 0.5 - (1 + jy - jx * 0.5) * oy / 2, 0)
	tbar.Size = UDim2.new((1 + jx - jy * 0.5) * ox, 0, 0, TBAR_H)
	-- glow + stroke already handled by setGlow
	return true
end)

