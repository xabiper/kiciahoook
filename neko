local function openPopup(btn, opts, current, onPick, arrow)
	closePopup()
	local rowH = 28
	local total = #opts * rowH + 8
	local bw = btn.AbsoluteSize.X
	local menuW = math.max(bw, 130)
	local vp = screen.AbsoluteSize
	local function place()
		local ax, ay = btn.AbsolutePosition.X, btn.AbsolutePosition.Y
		local bh = math.max(btn.AbsoluteSize.Y, btn.Size.Y.Offset)
		local y = ay + bh + 6 + 65 -- below the button, moved down 65px as asked
		if y + total > vp.Y - 8 then
			y = math.max(8, ay - total - 6) -- flip up near the bottom
		end
		return math.clamp(ax, 8, vp.X - menuW - 8), y
	end
	local px0, py0 = place()
	local f = new("Frame", {
		Position = UDim2.fromOffset(px0, py0),
		Size = UDim2.fromOffset(menuW, 0),
		BackgroundColor3 = C.selMenu,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 60,
	}, screen)
	corner(f, 11)
	stroke(f, C.white, 0.94, 1)
	-- drop shadow behind the menu, sized and moved with it
	local sh = new("Frame", { BackgroundColor3 = C.black, BackgroundTransparency = 0.6, BorderSizePixel = 0, ZIndex = 59 }, screen)
	corner(sh, 14)
	local sp = spring(0, 420, 24)
	killWith(sp, f)
	tick(function()
		if f.Parent == nil then
			return false
		end
		local nx, ny = place()
		local h = math.max(sp.x, 0)
		f.Position = UDim2.fromOffset(nx, ny)
		f.Size = UDim2.fromOffset(menuW, h)
		sh.Position = UDim2.fromOffset(nx - 2, ny + 6)
		sh.Size = UDim2.fromOffset(menuW + 4, h > 0 and h + 4 or 0)
		return true
	end)
	for i, o in ipairs(opts) do
		local isCur = (o == current)
		local restPos = UDim2.fromOffset(4, 4 + (i - 1) * rowH)
		local ob = new("TextButton", {
			Size = UDim2.new(1, -8, 0, rowH),
			Position = restPos,
			BackgroundColor3 = isCur and ACCENT or C.rowH,
			BackgroundTransparency = isCur and 0.87 or 1,
			BorderSizePixel = 0,
			Text = tostring(o),
			Font = F_MED,
			TextSize = 11.5,
			TextColor3 = isCur and ACCENT2 or C.mut,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			ZIndex = 61,
		}, f)
		corner(ob, 8)
		squishy(ob, 1.02, 0.97, 0.96, 1.04, nil, true) -- options keep their top-left positions
		new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, ob)
		if isCur then
			if ASSETS.chrome.tick ~= "" then
				new("ImageLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(11, 11), BackgroundTransparency = 1, Image = ASSETS.chrome.tick, ImageColor3 = ACCENT2, ZIndex = 62 }, ob)
			else
				label(ob, "✓", 11, ACCENT2, F_BOLD, { Size = UDim2.new(1, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 62 })
			end
		end
		ob.MouseEnter:Connect(function()
			-- .opt:hover -> translateX(3px) scale(1.02)
			tween(ob, { BackgroundTransparency = 0, BackgroundColor3 = C.rowH, TextColor3 = C.txt, Position = UDim2.fromOffset(7, 4 + (i - 1) * rowH) }, 0.15)
		end)
		ob.MouseLeave:Connect(function()
			local goal = { Position = restPos }
			if isCur then
				goal.BackgroundTransparency = 0.87
				goal.BackgroundColor3 = ACCENT
				goal.TextColor3 = ACCENT2
			else
				goal.BackgroundTransparency = 1
				goal.TextColor3 = C.mut
			end
			tween(ob, goal, 0.15)
