-- logo frame update: bob (lbob), float (logoFloat), and the pop springs
tick(function()
	local f = 0
	if T > 1.2 then
		f = (1 - math.cos(2 * math.pi * (T - 1.2) / 5.5)) / 2
	end
	mark.Position = UDim2.fromOffset(30, 3 - 3 * f)
	mark.Rotation = -1.5 * f
	logoScale.Scale = math.max(logoIn.x, 0)
	local bobPhase = (1 - math.cos(2 * math.pi * T / 2.6)) / 2
	for _, st in ipairs(letters) do
		local sv = math.clamp(st.sc.x, 0, 1)
		local yo = st.oy.x - bobPhase * 2.5
		st.frame.Position = UDim2.fromOffset(st.cx, st.cy + st.yoff + yo)
		st.frame.Rotation = st.rot + st.rr.x
		st.sc2.Scale = math.max(st.sc.x, 0) * st.pr.x
		if st.shadow then
