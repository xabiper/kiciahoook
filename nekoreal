-- label with two offset ghost copies, used to fake a blur on entry
local function blurLabel(parent, text, size, color, font, props, ghosts)
	local px, py = props.Position.X.Offset, props.Position.Y.Offset
	for _, dx in ipairs({ -1.5, 1.5 }) do
		local g = label(parent, text, size, color, font, { Position = UDim2.fromOffset(px + dx, py), Size = props.Size, TextXAlignment = props.TextXAlignment, ZIndex = 3 })
		g.TextTransparency = 0.5
		table.insert(ghosts, g)
	end
	return label(parent, text, size, color, font, props)
end
 
local function buildPage(tab)
	local holder = new("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, GroupTransparency = 1, ZIndex = 2 }, pageArea)
	local scroll = new("ScrollingFrame", {
		Position = UDim2.fromOffset(14, 2),
