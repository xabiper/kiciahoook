	new("UIPadding", { PaddingBottom = UDim.new(0, 16) }, scroll)
	local rowIx = 0
	local groupsHere = {}
	for gi, g in ipairs(tab.groups) do
		if g.closed == nil then
			g.closed = false
		end
		local group = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = gi, ZIndex = 2 }, scroll)
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, group)
