        if origNamecall and rawmeta then
            pcall(function()
                local mt = rawmeta(game)
                local ro = isRO(mt); if ro then setRO(mt, false) end
                mt.__namecall = origNamecall
                if ro then setRO(mt, true) end
            end)
        end
        -- restore camera
        pcall(function() cam.FieldOfView = 70; cam.CameraType = Enum.CameraType.Custom end)
        pcall(prevStop)
    end
