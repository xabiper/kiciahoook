local function buildTabs(sec, instant)
	for _, b in ipairs(tabBtns) do
		b:Destroy()
	end
	tabBtns = {}
	if tabPill then
		tabPill.frame:Destroy()
	end
	tabPill = makePill(tabsEl, true)
	-- the selected tab keeps the grey-to-white outline on its pill
	tabPillOutline = pillOutline(tabPill.frame)
	tabPillOutline.Transparency = 0.2
	local x = 0
	local positions = {}
	for ti, tab in ipairs(sec.tabs) do
		local w = textW(tab.id, 12, F_SEMI) + 28
		local b = new("TextButton", {
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.fromOffset(w, 28),
			BackgroundColor3 = Color3.fromHex("#2a2a33"), -- hover pill: the squish needs a visible shape to show on
			BackgroundTransparency = 1,
			Text = tab.id,
			Font = F_SEMI,
			TextSize = 12,
			TextColor3 = C.mut,
			AutoButtonColor = false,
			ZIndex = 3,
		}, tabsEl)
		positions[ti] = { x, x + w }
		tabBtns[ti] = b
		corner(b, 999)
		b.MouseEnter:Connect(function()
			if currentTab ~= tab then
				tween(b, { TextColor3 = ACCENT, BackgroundTransparency = 0.3 }, 0.15) -- hover: darker pink text, pill appears
			end
		end)
		b.MouseLeave:Connect(function()
			if currentTab ~= tab then
				tween(b, { TextColor3 = C.mut, BackgroundTransparency = 1 }, 0.15)
			end
		end)
		b.Activated:Connect(function()
			if currentTab == tab then
				closePopup()
				return
			end
			local prevIdx = table.find(sec.tabs, currentTab)
			currentTab = tab
			-- the hover pill must not stay behind on the tab we just left, or on the one we picked
			if prevIdx and prevIdx ~= ti and tabBtns[prevIdx] then
				tween(tabBtns[prevIdx], { BackgroundTransparency = 1 }, 0.15)
			end
			tween(b, { BackgroundTransparency = 1 }, 0.15)
			pillTo(positions[ti])
			for j, bb in ipairs(tabBtns) do
				tween(bb, { TextColor3 = (j == ti) and ACCENT2 or C.mut }, 0.2)
			end
			showPage(sec, tab)
		end)
		local tInfo = ASSETS.text[tab.id]
		local tsq, isq
		if tInfo and tInfo[1] ~= "" then
			-- image text: the bubble and the image share one anchor and one squish, so the bubble follows the image.
			-- bottom-anchored, so holding stretches UP
			b.AnchorPoint = Vector2.new(0.5, 0.5)
			b.Position = UDim2.fromOffset(x + w / 2, 14)
			b.TextTransparency = 1
			local tImg = new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(tInfo[2], tInfo[3]), BackgroundTransparency = 1, Image = tInfo[1], ImageColor3 = C.mut, ZIndex = 4 }, b)
			b:GetPropertyChangedSignal("TextColor3"):Connect(function()
				tImg.ImageColor3 = b.TextColor3
			end)
			-- hover: sides stretch ~20% wider, height unchanged; press: ~12% narrower (letters closer), ~30% taller, all from the center
			tsq = squishy(b, 1.125, 1, 0.925, 1.1875, nil, true)
			isq = squishy(b, 1.125, 1, 0.925, 1.1875, tImg, true)
		else
			tsq = squishy(b, 1.04, 0.9, 0.86, 0.8) -- hover: stretched sideways and squashed down; press: bundled up
		end
		snap(tsq, 0.85)
		if isq then
			snap(isq, 0.85)
		end
		task.delay((ti - 1) * 0.045, function()
			if b.Parent then
				setT(tsq, 1)
				if isq then
					setT(isq, 1)
				end
			end
		end)
		x = x + w + 4
	end
	pillTo(positions[1], instant)
	for j, bb in ipairs(tabBtns) do
		bb.TextColor3 = (j == 1) and ACCENT2 or C.mut
	end
end
 
