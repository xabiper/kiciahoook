-- =====================================================================
-- spring engine (same constants as the web build)
-- =====================================================================
local springs = {}
local ticks = {}
local themes = {}
local T = 0
 
local function spring(x, k, d)
	return { x = x, v = 0, t = x, k = k or 420, d = d or 22, live = false, dead = false }
end
local function wake(s)
	if not s.live then
		s.live = true
		table.insert(springs, s)
	end
end
local function setT(s, t)
	if _G.NEKO_ANIM_OFF then s.x = t; s.v = 0; s.t = t; return end
	s.t = t
	wake(s)
end
local function kick(s, dv)
	if _G.NEKO_ANIM_OFF then
		return
	end
	s.v = s.v + dv
	wake(s)
end
local function snap(s, x)
	s.x = x
	s.t = x
	s.v = 0
end
local function killWith(s, inst)
	inst.Destroying:Connect(function()
		s.dead = true
	end)
end
local function tick(fn)
	table.insert(ticks, fn)
end
local function themed(obj, fn)
	table.insert(themes, function()
		if not obj:IsDescendantOf(game) then
			return false
		end
		fn()
	end)
end
 
renderConn = RunService.RenderStepped:Connect(function(dt)
	if not ALIVE then
		return
	end
	dt = math.min(dt, 1 / 30)
	T = T + dt
	for i = #springs, 1, -1 do
		local s = springs[i]
		if s.dead then
			s.live = false
			table.remove(springs, i)
		else
			local a = -s.k * (s.x - s.t) - s.d * s.v
			s.v = s.v + a * dt
			s.x = s.x + s.v * dt
			if math.abs(s.x - s.t) < 0.02 and math.abs(s.v) < 0.05 then
				s.x = s.t
				s.v = 0
				s.live = false
				table.remove(springs, i)
			end
		end
	end
	for i = #ticks, 1, -1 do
		if ticks[i](dt) == false then
			table.remove(ticks, i)
		end
	end
end)
 
-- squishy press feedback (hover / press / release), uses a UIScale spring
-- per-element squish state, shared by squishy() and popStretch()
local FX = setmetatable({}, { __mode = "k" })
 
-- every squish is scaled around the element's center (CSS transform-origin: 50% 50%)
local function toCenter(obj)
	local A = obj.AnchorPoint
	if A.X == 0.5 and A.Y == 0.5 then
		return
	end
	local P, S = obj.Position, obj.Size
	local function shift(p, sz, a)
		local k = 0.5 - a
		return UDim.new(p.Scale + sz.Scale * k, p.Offset + sz.Offset * k)
	end
	obj.Position = UDim2.new(shift(P.X, S.X, A.X), shift(P.Y, S.Y, A.Y))
	obj.AnchorPoint = Vector2.new(0.5, 0.5)
end
 
-- how far the squish goes: the html values, pushed further (more aggressive)
local SQUISH_GAIN = 1.6
 
-- index.html @keyframes played from a start time: returns a function giving (scaleX, scaleY)
local function kfPlay(KF, t0)
	return function()
		if _G.NEKO_ANIM_OFF then
			return KF[#KF][2], KF[#KF][3]
		end
		local t = T - t0
		if t < 0 then
			return KF[1][2], KF[1][3]
		end
		if t >= KF[#KF][1] then
			return KF[#KF][2], KF[#KF][3]
		end
		for i = 1, #KF - 1 do
			local a, b = KF[i], KF[i + 1]
			if t <= b[1] then
				local u = (t - a[1]) / (b[1] - a[1])
				return a[2] + (b[2] - a[2]) * u, a[3] + (b[3] - a[3]) * u
			end
		end
		return KF[#KF][2], KF[#KF][3]
	end
end
 
-- CSS-style squish: hover -> scale(hovX, hovY), press -> scale(pressX, pressY).
-- Uses Size, so X and Y stretch independently (like the html transform: scale(x, y)).
local function squishy(btn, hovX, hovY, pressX, pressY, target, noCenter, txt)
	target = target or btn
	if not noCenter then
		toCenter(target)
	end
	hovX = hovX or 1.03
	hovY = hovY or 1
	pressX = pressX or 0.96
	pressY = pressY or 1.04
	hovX = 1 + (hovX - 1) * SQUISH_GAIN
	hovY = 1 + (hovY - 1) * SQUISH_GAIN
	pressX = 1 + (pressX - 1) * SQUISH_GAIN
	pressY = 1 + (pressY - 1) * SQUISH_GAIN
	local base = target.Size
	local sx = spring(1, 420, 13) -- lower damping = more bounce
	local sy = spring(1, 420, 13)
	local fx = { px = spring(1, 300, 16), py = spring(1, 300, 16) }
	-- optional text squish: a UIScale on the text holder, uniform (text can't stretch on one axis)
	local txtSc, ts, txtHov, txtPress
	if txt then
		local txtObj = txt.obj or btn
		txtSc = new("UIScale", {}, txtObj)
		ts = spring(1, 420, 13)
		killWith(ts, txtObj)
		txtHov, txtPress = txt.hov or 0.9, txt.press or 0.82
	end
	FX[target] = fx
	killWith(sx, target)
	killWith(sy, target)
	killWith(fx.px, target)
	killWith(fx.py, target)
	local hovering, pressing = false, false
	local function aim()
		if ts then
			setT(ts, pressing and txtPress or (hovering and txtHov or 1))
		end
		if pressing then
			setT(sx, pressX)
			setT(sy, pressY)
		elseif hovering then
			setT(sx, hovX)
			setT(sy, hovY)
		else
			setT(sx, 1)
			setT(sy, 1)
		end
	end
	local lastKX, lastKY = -1, -1
	tick(function()
		if target.Parent == nil then
			return false
		end
		if txtSc then
			txtSc.Scale = ts.x
		end
		if fx.entering then
			return true -- the row entrance owns Size until it finishes
		end
		local ek, ey = 1, 1
		if fx.kf then
			ek, ey = fx.kf()
		end
		local kx = sx.x * fx.px.x * ek
		local ky = sy.x * fx.py.x * ey
		-- only write when the size actually changes: every Size write re-runs the layout
		if kx ~= lastKX or ky ~= lastKY then
			lastKX, lastKY = kx, ky
			target.Size = UDim2.new(base.X.Scale * kx, base.X.Offset * kx, base.Y.Scale * ky, base.Y.Offset * ky)
		end
		return true
	end)
	btn.MouseEnter:Connect(function()
		hovering = true
		aim()
	end)
	btn.MouseLeave:Connect(function()
		hovering = false
		pressing = false
		aim()
	end)
	btn.MouseButton1Down:Connect(function()
		pressing = true
		aim()
	end)
	btn.MouseButton1Up:Connect(function()
		pressing = false
		aim()
	end)
	return sx
end
 
-- click feedback: goes OUT past full size, snaps back under it, then settles in.
-- Keyframes (seconds, scaleX, scaleY) with overshoot on both sides, so it reads as an
-- aggressive out-and-in with an elastic ease.
local CLICK_KF = {
	{ 0.00, 1.00, 1.00 },
	{ 0.10, 1.16, 0.80 }, -- out, squashed tall
	{ 0.22, 0.90, 1.14 }, -- back in, squashed wide
	{ 0.34, 1.08, 0.94 }, -- out again, smaller
	{ 0.46, 0.98, 1.03 },
	{ 0.56, 1.00, 1.00 },
}
local function popStretch(obj)
	local fx = FX[obj]
	if not fx or _G.NEKO_ANIM_OFF then
		return
	end
	fx.kf = kfPlay(CLICK_KF, T)
end
 
