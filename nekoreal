    local prevStop = _G.NEKO_STOP
    _G.NEKO_STOP = function()
        ALIVE = false
        -- ESP drawings
        for p in pairs(espCache) do purgeESP(p) end
        -- all other Drawing objects
        for _, obj in ipairs(_drawings) do pcall(function() obj:Remove() end) end
        -- chams
        for _, hl in pairs(chamCache) do pcall(function() hl:Destroy() end) end
