local function new(class, props, parent)
	local o = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			o[k] = v
		end
	end
	if parent then
		o.Parent = parent
	end
	return o
end
 
local function corner(o, r)
	return new("UICorner", { CornerRadius = (r == 999) and UDim.new(1, 0) or UDim.new(0, r) }, o)
end
 
local function stroke(o, color, transp, thick)
	return new("UIStroke", { Color = color or C.white, Transparency = transp or BORDER_T, Thickness = thick or 1 }, o)
end
 
local function label(parent, text, size, color, font, props)
	local l = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text or "",
		TextSize = size or 12,
		TextColor3 = color or C.txt,
		Font = font or F_REG,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(1, 0, 0, 16),
	}, parent)
	if props then
		for k, v in pairs(props) do
			l[k] = v
		end
	end
	return l
end
 
local function tween(obj, goal, dur, style, delayT)
	if _G.NEKO_ANIM_OFF then
		for k, v in pairs(goal) do
			obj[k] = v
		end
		return { Play = function() end, Cancel = function() end }
	end
	local info = TweenInfo.new(dur, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, delayT or 0)
	local tw = TweenService:Create(obj, info, goal)
	tw:Play()
	return tw
end
 
