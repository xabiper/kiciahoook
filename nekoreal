		BackgroundColor3 = startOn and ACCENT or C.switchOff,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	}, row)
	corner(track, 999)
	stroke(track, C.white, 0.93, 1)
	squishy(track, 1.08, 0.92, 0.94, 1.06)
	-- faint accent glow while the toggle is enabled; fades out over the same time as the toggle moves
	local glow = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 12, 1, 12), BackgroundColor3 = ACCENT, BackgroundTransparency = startOn and 0.82 or 1, BorderSizePixel = 0, ZIndex = 1 }, track)
	corner(glow, 999)
	local function glowTo(isOn)
		tween(glow, { BackgroundTransparency = isOn and 0.82 or 1, BackgroundColor3 = ACCENT }, 0.4, Enum.EasingStyle.Quad)
	end
	local on = startOn
	local trail = new("Frame", { Position = UDim2.fromOffset(3, 4), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = C.white, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 2 }, track)
	corner(trail, 999)
	local knob = new("Frame", { Position = UDim2.fromOffset(3, 3), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = C.white, BorderSizePixel = 0, ZIndex = 3 }, track)
	corner(knob, 999)
	local kn = spring(on and 22 or 3, 380, 18)
	local tr = spring(on and 22 or 3, 180, 16)
	local pr = spring(0, 420, 20) -- :active knob width 16 -> 21 (and left 22 -> 17 when on)
	killWith(kn, track)
	killWith(tr, track)
	killWith(pr, track)
	-- index.html @keyframes knobSquish (0.55s), in order: 0% 1, 30% (1.55,.7), 60% (.75,1.2), 80% (1.08,.95), 100% 1
	local KF = { { 0, 1, 1 }, { 0.165, 1.9, 0.55 }, { 0.33, 0.6, 1.4 }, { 0.44, 1.15, 0.9 }, { 0.55, 1, 1 } }
	local sqT = nil
	local function knobSquishScale()
		if not sqT or _G.NEKO_ANIM_OFF then
			return 1, 1
		end
		local t = T - sqT
		if t >= 0.55 then
			sqT = nil
			return 1, 1
		end
		for i = 1, #KF - 1 do
			local k0, k1 = KF[i], KF[i + 1]
			if t <= k1[1] then
				local u = (t - k0[1]) / (k1[1] - k0[1])
				return k0[2] + (k1[2] - k0[2]) * u, k0[3] + (k1[3] - k0[3]) * u
			end
		end
		return 1, 1
	end
	track.MouseButton1Down:Connect(function()
		setT(pr, 5)
	end)
	track.MouseButton1Up:Connect(function()
		setT(pr, 0)
	end)
	tick(function()
		if track.Parent == nil then
			return false
		end
		local kx, ky = knobSquishScale()
		local w = 16 + pr.x + math.min(math.abs(kn.v) * 0.015, 6)
		local left = kn.x - ((on and pr.x) or 0)
		-- positions are measured from the track's centre and scaled by the track's current squish,
		-- so the knob stays centred in the track while the track stretches
		local tkx = track.Size.X.Offset / 41
		local tky = track.Size.Y.Offset / 22
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.Position = UDim2.new(0.5, (left + w / 2 - 20.5) * tkx, 0.5, 0)
		knob.Size = UDim2.fromOffset(w * kx * tkx, 16 * ky * tky)
		trail.AnchorPoint = Vector2.new(0.5, 0.5)
		trail.Position = UDim2.new(0.5, (tr.x + 7 - 20.5) * tkx, 0.5, 0)
		trail.Size = UDim2.fromOffset(14 * tkx, 14 * tky)
		return true
	end)
	local function paint()
		tween(track, { BackgroundColor3 = on and ACCENT or C.switchOff }, 0.25)
	end
	themed(track, function()
		if on then
			track.BackgroundColor3 = ACCENT
		end
	end)
	track.Activated:Connect(function()
		on = not on
		sqT = T -- knobSquish animation
		popStretch(track) -- whole-track out-and-in, same as the dropdown click
		glowTo(on)
		setFlag(item.id, on)
		setT(kn, on and 22 or 3)
		setT(tr, on and 22 or 3)
		paint()
	end)
	onFlag[item.id] = function(v)
		v = v == true
		if v ~= on then
			on = v
			setT(kn, on and 22 or 3)
			setT(tr, on and 22 or 3)
			paint()
			glowTo(on)
		end
	end
end
 
