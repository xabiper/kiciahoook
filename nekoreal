-- __namecall hook: rewrites Vector3/CFrame args on FireServer while silent aim is live.
-- newcclosure wraps it in a new C closure so script identity checks pass.
local origNamecall
local function hookSilentAim()
    if not rawmeta then return end
    local mt = rawmeta(game)
    if not mt then return end
    origNamecall = mt.__namecall
    local ro = isRO(mt); if ro then setRO(mt, false) end
    mt.__namecall = newcc(function(self, ...)
        if ncm() == "FireServer" and silentTarget then
            if math.random(1,100) <= (Flags.silent_hitchance or 100) then
                local args = {...}
                for i, a in ipairs(args) do
                    if typeof(a) == "Vector3" then
                        args[i] = silentTarget.Position
                        return origNamecall(self, table.unpack(args))
                    elseif typeof(a) == "CFrame" then
                        args[i] = CFrame.new(silentTarget.Position)
                        return origNamecall(self, table.unpack(args))
                    end
                end
            end
        end
        return origNamecall(self, ...)
    end)
    if ro then setRO(mt, true) end
end
pcall(hookSilentAim)
 
-- ─── Triggerbot ───────────────────────────────────────────────────────
local tbNextShot = 0
 
local function triggerbotUpdate()
    if not Flags.triggerbot_enabled then return end
    if os.clock() < tbNextShot then return end
    local key = Flags.triggerbot_keybind
    if key and key ~= "Unbound" and not isKeyHeld(key) then return end
    local ctr   = screenCtr()
    local myHRP = getHRP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        if Flags.triggerbot_team and sameTeam(p) then continue end
        local char = p.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum or hum.Health <= 0 then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        if myHRP and (hrp.Position-myHRP.Position).Magnitude > (Flags.triggerbot_max_distance or 800) then continue end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                local sp, vis = w2s(part.Position)
                if vis and (sp-ctr).Magnitude < 14 then
                    local delayMs = (Flags.triggerbot_reaction_time or 50)
                                  + math.random(0, math.max(0, Flags.triggerbot_reaction_time_offset or 0))
                    tbNextShot = os.clock()
                               + delayMs/1000
                               + (Flags.triggerbot_shoot_delay or 0)/1000
                               + 0.08
                    task.delay(delayMs/1000, function()
                        pcall(function()
                            local vim = game:GetService("VirtualInputManager")
                            vim:SendMouseButtonEvent(ctr.X, ctr.Y, 0, true,  game, 1)
                            task.delay(0.05, function()
                                pcall(function()
                                    vim:SendMouseButtonEvent(ctr.X, ctr.Y, 0, false, game, 1)
                                end)
                            end)
                        end)
                    end)
                    return
                end
            end
        end
    end
end
 
-- ─── Fly ──────────────────────────────────────────────────────────────
local flyBV, flyBG = nil, nil
 
local function startFly()
    local char = player.Character; if not char then return end
    local hrp  = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = true end
    if flyBV then flyBV:Destroy() end
    if flyBG then flyBG:Destroy() end
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.one * 1e5
    flyBV.Velocity = Vector3.zero
    flyBV.Parent   = hrp
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.one * 1e5
    flyBG.D        = 150
    flyBG.Parent   = hrp
end
 
local function stopFly()
    if flyBV then flyBV:Destroy(); flyBV=nil end
    if flyBG then flyBG:Destroy(); flyBG=nil end
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
end
 
local function flyUpdate()
    if not Flags.movement_fly then if flyBV then stopFly() end; return end
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not flyBV or not flyBV.Parent then startFly(); return end
    local speed = Flags.movement_flyvalue or 100
    local cf    = cam.CFrame
    local dir   = Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cf.LookVector  end
    if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cf.LookVector  end
    if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cf.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cf.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.Space)       then dir = dir + Vector3.new(0,1,0)  end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl)
    or UIS:IsKeyDown(Enum.KeyCode.LeftShift)   then dir = dir - Vector3.new(0,1,0)  end
    flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * speed or Vector3.zero
    if flyBG then flyBG.CFrame = CFrame.lookAt(Vector3.zero, cf.LookVector) end
end
 
