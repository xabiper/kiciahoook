		BorderSizePixel = 0,
		Text = glyph,
		TextSize = 13,
		Font = F_BOLD,
		TextColor3 = C.tbarMut,
		AutoButtonColor = false,
		ZIndex = 4,
	}, tbar)
	corner(b, 7)
	local img = nil
	if asset and asset ~= "" then
		b.Text = ""
		img = new("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1, Image = asset, ImageColor3 = C.tbarMut, ZIndex = 5,
		}, b)
	end
	b.MouseEnter:Connect(function()
		tween(b, { BackgroundTransparency = 0, TextColor3 = hoverFg }, 0.15)
		if img then
			tween(img, { ImageColor3 = hoverFg }, 0.15)
		end
	end)
	b.MouseLeave:Connect(function()
		tween(b, { BackgroundTransparency = 1, TextColor3 = C.tbarMut }, 0.15)
		if img then
			tween(img, { ImageColor3 = C.tbarMut }, 0.15)
		end
	end)
	b.Activated:Connect(onClick)
	squishy(b, 1.12, 0.88, 0.88, 1.1)
	return b
end
 
