local function titleBtn(glyph, xOff, hoverBg, hoverFg, onClick, name, asset)
	local b = new("TextButton", {
		Name = name,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, xOff, 0.5, 0),
		Size = UDim2.fromOffset(36, 26),
