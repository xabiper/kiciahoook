-- ─── Crosshair ────────────────────────────────────────────────────────
local chL, chO = {}, {}
for i = 1,4 do
    chL[i] = D("Line",{Visible=false,Thickness=2,ZIndex=15})
    chO[i] = D("Line",{Visible=false,Thickness=4,ZIndex=14})
end
 
local function updateCrosshair()
    if not Flags.crosshair_enabled then
        for i=1,4 do chL[i].Visible=false; chO[i].Visible=false end; return
    end
    local ctr   = screenCtr()
    local len   = Flags.crosshair_length    or 12
    local gap   = Flags.crosshair_offset    or 4
    local thick = Flags.crosshair_thickness or 2
    local col   = hexC(Flags.crosshair_color_1)
    local ocol  = hexC(Flags.crosshair_outline_color_1)
    local useO  = Flags.crosshair_outline
    local dirs  = {
        {Vector2.new(0,-gap),  Vector2.new(0,-(gap+len))},
        {Vector2.new(0, gap),  Vector2.new(0,  gap+len)},
        {Vector2.new(-gap, 0), Vector2.new(-(gap+len),0)},
        {Vector2.new( gap, 0), Vector2.new(  gap+len, 0)},
    }
    for i, d in ipairs(dirs) do
        chL[i].From=ctr+d[1]; chL[i].To=ctr+d[2]; chL[i].Color=col; chL[i].Thickness=thick; chL[i].Visible=true
        if useO then
            chO[i].From=ctr+d[1]; chO[i].To=ctr+d[2]; chO[i].Color=ocol; chO[i].Thickness=thick+2; chO[i].Visible=true
        else chO[i].Visible=false end
    end
end
 
-- ─── Aimbot ───────────────────────────────────────────────────────────
local aimbotOn = false   -- for Toggle mode
 
local function aimbotUpdate()
    if not Flags.aimbot_toggle then return end
    local mode = Flags.aimbot_mode or "Hold"
    local active = (mode=="Always") or (mode=="Toggle" and aimbotOn)
                or (mode=="Hold" and isKeyHeld(Flags.aimbot_keybind))
    if not active then return end
    local _, part = pickTarget(
        Flags.aimbot_radius or 120,
        Flags.aimbot_closest_part or "Head",
        Flags.aimbot_team ~= false,
        Flags.aimbot_vis  ~= false
    )
    if not part then return end
    local smoothing = math.max(1, Flags.aimbot_smoothing or 5)
    local target    = CFrame.new(cam.CFrame.Position, part.Position)
    cam.CFrame      = cam.CFrame:Lerp(target, 1/smoothing)
end
 
-- ─── Silent Aim ───────────────────────────────────────────────────────
local silentTarget = nil
local silentOn     = false
 
local function updateSilentTarget()
    if not Flags.silent_toggle then silentTarget=nil; return end
    local mode = Flags.silent_mode or "Hold"
    local active = (mode=="Always") or (mode=="Toggle" and silentOn)
                or (mode=="Hold" and isKeyHeld(Flags.silent_keybind))
    if not active then silentTarget=nil; return end
    local _, part = pickTarget(
        Flags.silent_radius or 120,
        Flags.silent_closest_part or "Head",
        Flags.silent_team ~= false,
        Flags.silent_vis  ~= false
    )
    silentTarget = part
