-- ─── Camera ───────────────────────────────────────────────────────────
local function cameraUpdate()
    if Flags.camera_fov_changer then
        cam.FieldOfView = Flags.camera_fov_changer_amount or 70
    end
    if Flags.camera_blur then
        for _, e in ipairs(cam:GetChildren()) do
            if e:IsA("DepthOfFieldEffect") or e:IsA("BlurEffect") then e.Enabled = false end
        end
    end
    if Flags.camera_anti_flashbang then
        -- kill any flash gui by capping ScreenGui transparency
        for _, g in ipairs(player.PlayerGui:GetChildren()) do
            if g:IsA("ScreenGui") and g ~= screen then
                for _, f in ipairs(g:GetDescendants()) do
                    if f:IsA("Frame") and f.BackgroundColor3 == Color3.new(1,1,1)
                    and f.BackgroundTransparency < 0.9 and f.Size == UDim2.fromScale(1,1) then
                        f.BackgroundTransparency = 0.95
                    end
                end
            end
        end
    end
end
 
-- ─── Lighting effects ─────────────────────────────────────────────────
local function lightingUpdate()
    local li = Lighting
    -- bloom
    local bloom = li:FindFirstChildOfClass("Bloom")
    if Flags.bloom_enabled then
        if not bloom then bloom = Instance.new("Bloom", li) end
        bloom.Enabled   = true
        bloom.Intensity = Flags.bloom_intensity or 1
        bloom.Size      = Flags.bloom_size      or 24
        bloom.Threshold = Flags.bloom_threshold or 2
    elseif bloom then bloom.Enabled = false end
    -- color correction
    local cc = li:FindFirstChildOfClass("ColorCorrectionEffect")
    if Flags.color_correction_enabled then
        if not cc then cc = Instance.new("ColorCorrectionEffect", li) end
        cc.Enabled    = true
        cc.Brightness = Flags.color_correction_brightness or 0
        cc.Contrast   = Flags.color_correction_contrast   or 0
        cc.Saturation = Flags.color_correction_saturation or 0
        cc.TintColor  = hexC(Flags.color_correction_tint)
    elseif cc then cc.Enabled = false end
end
 
-- ─── Chat spam ────────────────────────────────────────────────────────
local spamThread = nil
 
local function startSpam()
    if spamThread then task.cancel(spamThread) end
    spamThread = task.spawn(function()
        local tcs = game:GetService("TextChatService")
        while Flags.chat_spam_enabled do
            local raw  = tostring(Flags.chat_spam_text or "")
            local msgs = {}
            for m in (raw.."|"):gmatch("([^|]+)|") do table.insert(msgs, m) end
            if #msgs == 0 then msgs = {"gg"} end
            local mode = Flags.chat_spam_mode or "Random"
            local idx  = (mode == "Random") and math.random(1,#msgs) or 1
            local msg  = msgs[idx]
            pcall(function()
                local ch = tcs:FindFirstChildOfClass("TextChannel")
                if ch then ch:SendAsync(msg) end
            end)
            task.wait(0.6 + math.random()*0.6)
        end
    end)
end
 
onFlag.__pin.chat_spam_enabled = function(on)
    if on then startSpam()
    elseif spamThread then task.cancel(spamThread); spamThread=nil end
end
 
