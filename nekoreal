-- =====================================================================
task.spawn(function()
local cam = workspace.CurrentCamera
local WS  = workspace
 
-- executor shims: degrade gracefully when a func isn't available
local newcc   = (type(newcclosure)      == "function") and newcclosure      or function(f) return f end
local rawmeta = (type(getrawmetatable)  == "function") and getrawmetatable  or nil
local isRO    = (type(isreadonly)       == "function") and isreadonly       or function() return false end
local setRO   = (type(setreadonly)      == "function") and setreadonly      or function() end
local ncm     = (type(getnamecallmethod)== "function") and getnamecallmethod or function() return "" end
 
-- ─── helpers ──────────────────────────────────────────────────────────
local function hexC(h)
    local ok, c = pcall(Color3.fromHex, h or "#ffffff")
    return ok and c or Color3.new(1,1,1)
end
 
local function sameTeam(p)
    return player.Team ~= nil and p.Team ~= nil and player.Team == p.Team
end
 
local function getHRP()
    return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end
 
local function screenCtr()
    local v = cam.ViewportSize
    return Vector2.new(v.X/2, v.Y/2)
end
 
local function w2s(pos)
    local sp, vis = cam:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), vis
end
 
local function rayVis(part)
    local char = player.Character
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char, WS.Terrain}
    local dir = part.Position - cam.CFrame.Position
    local res = WS:Raycast(cam.CFrame.Position, dir, params)
    return res == nil or (res.Instance and res.Instance:IsDescendantOf(part.Parent))
end
 
local function getTargetPart(char, name)
    if name == "Closest" then
        local ctr = screenCtr(); local best, bd = nil, math.huge
        for _, p in ipairs(char:GetChildren()) do
            if p:IsA("BasePart") then
                local sp, vis = w2s(p.Position)
                if vis then local d=(sp-ctr).Magnitude; if d<bd then bd=d; best=p end end
            end
        end
        return best
    end
    return char:FindFirstChild(name) or char:FindFirstChild("HumanoidRootPart")
end
 
local function pickTarget(radius, partName, teamCheck, visCheck)
    local ctr = screenCtr()
    local best, bestPart, bestD = nil, nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        if teamCheck and sameTeam(p) then continue end
        local char = p.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum or hum.Health <= 0 then continue end
        local part = getTargetPart(char, partName)
        if not part then continue end
        if visCheck and not rayVis(part) then continue end
        local sp, vis = w2s(part.Position)
        if not vis then continue end
        local d = (sp - ctr).Magnitude
        if d < radius and d < bestD then bestD=d; best=p; bestPart=part end
    end
    return best, bestPart
end
 
local function isKeyHeld(k)
    if not k or k == "Unbound" then return false end
    local ok, kc = pcall(function() return Enum.KeyCode[k] end)
    if ok and kc and kc ~= Enum.KeyCode.Unknown then
        if UIS:IsKeyDown(kc) then return true end
    end
    local mbMap = {MouseButton1=Enum.UserInputType.MouseButton1, MouseButton2=Enum.UserInputType.MouseButton2}
    if mbMap[k] then return UIS:IsMouseButtonPressed(mbMap[k]) end
    return false
end
 
-- ─── Drawing pool (auto-collected on unload) ──────────────────────────
local _drawings = {}
local function D(kind, props)
    local ok, obj = pcall(Drawing.new, kind)
    if not ok then
        -- stub so callers never crash
        local t = {}
        return setmetatable(t, {__index=function() return function() end end, __newindex=function(s,k,v) rawset(s,k,v) end})
    end
    for k, v in pairs(props or {}) do pcall(function() obj[k]=v end) end
    table.insert(_drawings, obj)
    return obj
end
 
-- ─── ESP ──────────────────────────────────────────────────────────────
local espCache = {}  -- [Player] = { box, fill, hpBg, hpBar, name, dist, weapon, skel={} }
 
local SKEL = {
    {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},  {"LeftUpperArm","LeftLowerArm"},  {"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},  {"LeftUpperLeg","LeftLowerLeg"},  {"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}
 
local function makeESPDrawings(p)
    local d = {
        box    = D("Square",{Visible=false,Filled=false,Thickness=1.5,ZIndex=5}),
        fill   = D("Square",{Visible=false,Filled=true, Transparency=0.65,ZIndex=4}),
        hpBg   = D("Square",{Visible=false,Filled=true, Color=Color3.new(0,0,0),Transparency=0.45,ZIndex=4}),
        hpBar  = D("Square",{Visible=false,Filled=true, ZIndex=5}),
        name   = D("Text",  {Visible=false,Size=13,Center=true,Outline=true,ZIndex=6}),
        dist   = D("Text",  {Visible=false,Size=11,Center=true,Outline=true,ZIndex=6}),
        weapon = D("Text",  {Visible=false,Size=11,Center=true,Outline=true,ZIndex=6}),
        skel   = {},
    }
    for i = 1, #SKEL do
        d.skel[i] = D("Line",{Visible=false,Thickness=1,ZIndex=3})
    end
    espCache[p] = d
end
 
local function hideESPDrawings(d)
    d.box.Visible=false; d.fill.Visible=false
    d.hpBg.Visible=false; d.hpBar.Visible=false
    d.name.Visible=false; d.dist.Visible=false; d.weapon.Visible=false
    for _, l in ipairs(d.skel) do l.Visible=false end
end
 
local function purgeESP(p)
    local d = espCache[p]; if not d then return end
    for k, v in pairs(d) do
        if type(v)=="table" then for _, l in ipairs(v) do pcall(function() l:Remove() end) end
        else pcall(function() v:Remove() end) end
    end
    espCache[p] = nil
end
 
local function hpColor(pct)
    if pct > 0.5 then return Color3.new((1-pct)*2,1,0) else return Color3.new(1,pct*2,0) end
end
 
local function charBounds(char)
    local mn = Vector2.new(math.huge,math.huge)
    local mx = Vector2.new(-math.huge,-math.huge)
    local any = false
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            local sp, vis = w2s(part.Position)
            if vis then
                any = true
                mn = Vector2.new(math.min(mn.X,sp.X), math.min(mn.Y,sp.Y))
                mx = Vector2.new(math.max(mx.X,sp.X), math.max(mx.Y,sp.Y))
            end
        end
    end
    return any and mn or nil, mx
end
 
local function espUpdate()
    -- ensure drawings exist for all live players
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and not espCache[p] then makeESPDrawings(p) end
    end
    -- purge disconnected players
    for p in pairs(espCache) do
        if not p.Parent then purgeESP(p) end
    end
 
    local anyOn = Flags.esp_box or Flags.esp_fill or Flags.esp_healthbar
               or Flags.esp_name or Flags.esp_distance or Flags.esp_weapon or Flags.esp_skeleton
    local myHRP = getHRP()
 
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        local d = espCache[p]; if not d then continue end
 
        local char = p.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
 
        if not anyOn or not char or not hrp or not hum then hideESPDrawings(d); continue end
        if not Flags.esp_show_team and sameTeam(p) then hideESPDrawings(d); continue end
 
        local dist = myHRP and (hrp.Position - myHRP.Position).Magnitude or 0
        if dist > (Flags.esp_max_distance or 1000) then hideESPDrawings(d); continue end
 
        local _, vis = w2s(hrp.Position)
        if not vis then hideESPDrawings(d); continue end
 
        local mn, mx = charBounds(char)
        if not mn then hideESPDrawings(d); continue end
 
        local bx, by = mn.X, mn.Y
        local bw, bh = mx.X - mn.X, mx.Y - mn.Y
        local wsc = Flags.esp_bounds_width_scale or 1
 
        -- box
        if Flags.esp_box then
            d.box.Position = Vector2.new(bx, by)
            d.box.Size     = Vector2.new(bw*wsc, bh)
            d.box.Color    = hexC(Flags.esp_box_color1)
            d.box.Visible  = true
        else d.box.Visible=false end
 
        -- fill
        if Flags.esp_fill then
            d.fill.Position = Vector2.new(bx, by)
            d.fill.Size     = Vector2.new(bw*wsc, bh)
            d.fill.Color    = hexC(Flags.esp_fill_color1)
            d.fill.Visible  = true
        else d.fill.Visible=false end
 
        -- health bar (left of box, 2px wide)
        if Flags.esp_healthbar then
            local pct = math.clamp(hum.Health / math.max(hum.MaxHealth,1), 0, 1)
            local bX  = bx - 6
            d.hpBg.Position = Vector2.new(bX-1, by-1)
            d.hpBg.Size     = Vector2.new(4, bh+2)
            d.hpBg.Visible  = true
            d.hpBar.Position= Vector2.new(bX, by + bh*(1-pct))
            d.hpBar.Size    = Vector2.new(2, bh*pct)
            d.hpBar.Color   = hpColor(pct)
            d.hpBar.Visible = true
        else d.hpBg.Visible=false; d.hpBar.Visible=false end
 
        -- name
        if Flags.esp_name then
            local nt = Flags.esp_name_type or "Display"
            local ns = nt=="Username" and p.Name
                    or nt=="Both"     and (p.DisplayName.." ("..p.Name..")")
                    or p.DisplayName
            d.name.Text     = ns
            d.name.Position = Vector2.new(bx+bw/2, by-16)
            d.name.Color    = hexC(Flags.esp_name_color1)
            d.name.Visible  = true
        else d.name.Visible=false end
 
        -- distance
        if Flags.esp_distance then
            d.dist.Text     = string.format("%.0fm", dist)
            d.dist.Position = Vector2.new(bx+bw/2, mx.Y+2)
            d.dist.Color    = hexC(Flags.esp_distance_color1)
            d.dist.Visible  = true
        else d.dist.Visible=false end
 
        -- weapon
        if Flags.esp_weapon then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                d.weapon.Text     = tool.Name
                d.weapon.Position = Vector2.new(bx+bw/2, mx.Y + (Flags.esp_distance and 14 or 2))
                d.weapon.Color    = hexC(Flags.esp_weapon_color1)
                d.weapon.Visible  = true
            else d.weapon.Visible=false end
        else d.weapon.Visible=false end
 
        -- skeleton
        if Flags.esp_skeleton then
            for i, conn in ipairs(SKEL) do
                local a = char:FindFirstChild(conn[1])
                local b = char:FindFirstChild(conn[2])
                local ln = d.skel[i]
                if a and b then
                    local spa, va = w2s(a.Position)
                    local spb, vb = w2s(b.Position)
                    if va and vb then
                        ln.From      = spa
                        ln.To        = spb
                        ln.Color     = hexC(Flags.esp_skeleton_color1)
                        ln.Thickness = Flags.esp_skeleton_thickness or 1
                        ln.Visible   = true
                    else ln.Visible=false end
                else ln.Visible=false end
            end
        else for _, l in ipairs(d.skel) do l.Visible=false end end
    end
end
 
